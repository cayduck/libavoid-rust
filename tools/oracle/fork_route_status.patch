+      m_has_valid_route(false),
       m_route_dist(0),
       m_src_vert(nullptr),
       m_dst_vert(nullptr),
@@ -85,6 +86,7 @@ ConnRef::ConnRef(Router *router, const ConnEnd& src, const ConnEnd& dst,
       m_active(false),
       m_hate_crossings(false),
       m_has_fixed_route(false),
+      m_has_valid_route(false),
