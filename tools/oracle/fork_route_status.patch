From fe73f026f02d40f7783bee2b7b49f653ae581291 Mon Sep 17 00:00:00 2001
From: Vladyslav Hnatiuk
Date: Mon, 23 Feb 2026 17:30:45 +0100
Subject: [PATCH] Add hasCrossingObstacles property to ConnRef

---
 cola/libavoid/connector.cpp | 50 ++++++++++++++++++++++++++++++++++++-
 cola/libavoid/connector.h   | 17 +++++++++++++
 2 files changed, 66 insertions(+), 1 deletion(-)

diff --git a/cola/libavoid/connector.cpp b/cola/libavoid/connector.cpp
index 1ec198fe..7ab0b2a1 100644
--- a/cola/libavoid/connector.cpp
+++ b/cola/libavoid/connector.cpp
@@ -37,6 +37,7 @@
 #include "libavoid/visibility.h"
 #include "libavoid/debug.h"
 #include "libavoid/assertions.h"
+#include "libavoid/obstacle.h"
 #include "libavoid/junction.h"
 #include "libavoid/makepath.h"
 #include "libavoid/debughandler.h"
@@ -647,6 +648,53 @@ bool ConnRef::hasValidRoute(void) const
     return m_has_valid_route;
 }
 
+bool ConnRef::hasCrossingObstacles(void) const
+{
+    const PolyLine& output_route = m_route;
+    if (output_route.size() < 2)
+    {
+        return false;
+    }
+
+    std::pair<Obstacle *, Obstacle *> anchors = endpointAnchors();
+    for (ObstacleList::const_iterator obstIt =
+            m_router->m_obstacles.begin();
+            obstIt != m_router->m_obstacles.end(); ++obstIt)
+    {
+        Obstacle *obstacle = *obstIt;
+        if (obstacle == anchors.first || obstacle == anchors.second)
+        {
+            continue;
+        }
+
+        Polygon obsPoly = obstacle->routingPolygon();
+
+        for (size_t i = 0; i < output_route.size() - 1; ++i)
+        {
+            const Point& p1 = output_route.ps[i];
+            const Point& p2 = output_route.ps[i + 1];
+
+            for (size_t j = 0; j < obsPoly.size(); ++j)
+            {
+                size_t nextJ = (j + 1) % obsPoly.size();
+                if (segmentIntersect(p1, p2,
+                        obsPoly.ps[j], obsPoly.ps[nextJ]))
+                {
+                    return true;
+                }
+            }
+
+            // Also check if a route point lies inside the obstacle.
+            if (inPoly(obsPoly, p1, false))
+            {
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
+
 void ConnRef::clearFixedRoute(void)
 {
     m_has_fixed_route = false;
@@ -1055,7 +1103,7 @@ bool ConnRef::generatePath(void)
     freeRoutes();
     PolyLine& output_route = m_route;
     output_route.ps = clippedPath;
- 
+
 #ifdef PATHDEBUG
     db_printf("Output route:\n");
     for (size_t i = 0; i < output_route.ps.size(); ++i)
diff --git a/cola/libavoid/connector.h b/cola/libavoid/connector.h
index 93148413..d82adc82 100644
--- a/cola/libavoid/connector.h
+++ b/cola/libavoid/connector.h
@@ -426,6 +426,23 @@ class AVOID_EXPORT ConnRef
         //!
         bool hasValidRoute(void) const;
 
+        //! @brief  Returns whether the connector's route crosses any
+        //!         obstacles that the connector is not attached to.
+        //!
+        //! After routing, the computed path may pass through obstacle
+        //! boundaries (e.g., when a connector endpoint is inside an
+        //! obstacle, or when the orthogonal router routes through
+        //! overlapping shapes).  This method checks all route segments
+        //! against all non-endpoint obstacles in the scene.
+        //!
+        //! @note   The result is only meaningful after a call to
+        //!         Router::processTransaction().
+        //!
+        //! @return True if the route crosses at least one obstacle,
+        //!         false if the route is obstacle-free.
+        //!
+        bool hasCrossingObstacles(void) const;
+
         //! @brief  Returns the connector to being automatically routed if it
         //!         was marked as fixed.
         //!
-- 
