{
  "name": "libavoid-rust",
  "version": "0.1.0",
  "description": "Rust/WASM port of the libavoid connector-routing library (adaptagrams) with a JavaScript API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cayduck/libavoid-rust.git"
  },
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      },
      "browser": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./web": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "lib/adapter.cjs",
    "lib/adapter.mjs",
    "PORTING.md",
    "pkg",
    "pkg-web",
    "src",
    "Cargo.toml",
    "Cargo.lock",
    "scripts/build-wasm.cjs",
    "scripts/prepare-pkg.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "node scripts/build-wasm.cjs nodejs pkg && node scripts/prepare-pkg.cjs",
    "build:web": "node scripts/build-wasm.cjs web pkg-web && node scripts/prepare-pkg.cjs",
    "build:demo": "npm run build:web && node scripts/build-demo.cjs",
    "demo": "node scripts/serve-demo.cjs",
    "test": "cargo test && npm run build && npm run test:node",
    "test:rust": "cargo test",
    "test:node": "node test/api-sync.cjs && node --expose-gc test/esm-entry.mjs && node test/node-smoke.cjs && node --expose-gc test/failure-containment.cjs",
    "test:demo": "npm run build:demo && node test/demo-browser.cjs",
    "test:types": "npx -y -p typescript@5.9 tsc -p test/types/tsconfig.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "libavoid",
    "wasm",
    "rust",
    "orthogonal",
    "routing",
    "diagram"
  ],
  "author": "Cayduck (https://github.com/cayduck)",
  "license": "LGPL-2.1-or-later",
  "devDependencies": {
    "wasm-pack": "^0.13.1"
  }
}
